# Copy this file to work/telegram.env and fill in your own values.
# Never commit or share the bot token.
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_CHAT_ID=replace_with_numeric_chat_id

# Alert only when: model basket probability - executable cost >= 10%.
POLYMARKET_MIN_NET_EDGE=0.10
POLYMARKET_MIN_COMBO_PROBABILITY=0.50
POLYMARKET_MIN_MODEL_SUPPORT=1
POLYMARKET_MIN_LEG_PRICE=0.001

# The same number of YES shares is bought in every selected temperature bin.
POLYMARKET_SHARES_PER_OUTCOME=10
POLYMARKET_BANKROLL_USD=10
POLYMARKET_MAX_CONTRACT_EXPOSURE=0.30
POLYMARKET_MIN_ORDER_SHARES=5

# Lead-time layers based on the official Polymarket event endDate.
POLYMARKET_24H_ENABLED=0
POLYMARKET_24H_MIN_PROBABILITY=0.60
POLYMARKET_24H_MIN_EDGE=0.10
POLYMARKET_12H_MIN_PROBABILITY=0.50
POLYMARKET_12H_MIN_EDGE=0.03
POLYMARKET_6H_MIN_PROBABILITY=0.55
POLYMARKET_6H_MIN_EDGE=0.02
POLYMARKET_3H_MIN_PROBABILITY=0.60
POLYMARKET_3H_MIN_EDGE=0.01

# When no opportunity qualifies, send at most one Telegram status message per 6 hours.
POLYMARKET_NO_SIGNAL_NOTICE_HOURS=6
POLYMARKET_HEALTH_NOTIFY=1
