[Unit]
Description=Polymarket public account trade watcher
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=shanghaiwx
Group=shanghaiwx
WorkingDirectory=/usr/unitree
ExecStart=/usr/bin/flock -n /usr/unitree/work/polymarket-account-watch.lock /usr/bin/python3 /usr/unitree/polymarket_account_watch.py --env-file /usr/unitree/work/telegram.env
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/usr/unitree/work

[Install]
WantedBy=multi-user.target
