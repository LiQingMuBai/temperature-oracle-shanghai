[Unit]
Description=Polymarket watched-account web dashboard
After=network.target polymarket-account-watch.service

[Service]
Type=simple
User=shanghaiwx
Group=shanghaiwx
WorkingDirectory=/usr/unitree
ExecStart=/usr/bin/python3 /usr/unitree/polymarket_account_dashboard.py --db /usr/unitree/work/polymarket_account_watch.sqlite3 --host 0.0.0.0 --port 8766
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/usr/unitree/work

[Install]
WantedBy=multi-user.target
